{
  "name": "lan-sync",
  "version": "1.0.0",
  "description": "局域网文件互传 + 协同编辑工具",
  "main": "server.js",
  "bin": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:win": "pkg . --target node22-win-x64 --output dist/LanSync.exe",
    "build:mac": "pkg . --target node22-macos-x64 --output dist/LanSync"
  },
  "pkg": {
    "assets": [
      "public/**/*"
    ],
    "scripts": [
      "server.js"
    ],
    "fallbackToSource": true,
    "targets": [
      "node22-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "docx-preview": "^0.4.1",
    "html-docx-js": "^0.3.1",
    "mammoth": "^1.13.0",
    "pptx-preview": "^1.0.7",
    "ws": "^8.18.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@yao-pkg/pkg": "^6.6.0"
  }
}
